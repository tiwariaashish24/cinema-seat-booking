# TMDB API Read Access Token (used as a Bearer token)
TMDB_TOKEN=your_tmdb_read_access_token_here

# Local PostgreSQL demo booking database. These credentials are for development only.
DATABASE_URL=postgres://cinema:cinema_dev_password@localhost:5433/cinema_booking?sslmode=disable
POSTGRES_DB=cinema_booking
POSTGRES_USER=cinema
POSTGRES_PASSWORD=cinema_dev_password

# Razorpay Payment Gateway Configuration
# Get these from https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Set to "true" or "1" for test mode, "false" or "0" for production
RAZORPAY_TEST_MODE=true

# Redis Configuration (if you want to change from default)
# REDIS_HOST=localhost
# REDIS_PORT=6379
